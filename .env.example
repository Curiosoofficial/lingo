# Vorlage für die Umgebungsvariablen.
# Kopieren nach ".env" (lokal) bzw. in Vercel unter Settings > Environment Variables eintragen.
# Hier NIE echte Werte eintragen: Diese Datei liegt öffentlich auf GitHub.

# Clerk (Login) – https://dashboard.clerk.com > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Postgres – https://console.neon.tech > Connection Details (Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORT@HOST.neon.tech/lingo?sslmode=require

# Stripe (Testmodus) – https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Signing Secret des Webhooks auf /api/webhooks/stripe (lokal: "stripe listen" gibt einen whsec_ aus)
STRIPE_WEBHOOK_SECRET=whsec_...

# Öffentliche Adresse der App (für die Stripe-Rücksprung-URL), ohne / am Ende
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Clerk-User-IDs mit Zugriff auf /admin, kommagetrennt (z.B. user_abc123,user_def456)
# ADMIN_USER_IDS=
